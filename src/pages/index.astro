---
import Layout from '../layouts/Layout.astro';
const year = new Date().getFullYear();
---

<Layout 
	title="LuckyDev | Páginas Web y Desarrollo de Software a Medida" 
	description="Agencia de desarrollo web y software a medida en México. Sitios corporativos, tiendas en línea y sistemas SaaS para marcas y empresas que buscan crecer."
>
	<!-- NAVBAR -->
	<header id="header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 border-b border-transparent">
		<div class="container mx-auto px-6 py-5 flex justify-between items-center">
			<div class="text-2xl font-black tracking-tighter text-white"><a href="#inicio">Lucky<span class="text-gradient">Dev</span></a></div>

			<nav class="hidden md:flex space-x-10" id="desktop-menu">
				<a href="#inicio" class="text-sm font-bold text-gray-300 hover:text-orange-400 transition-colors duration-300">Inicio</a>
				<a href="#servicios" class="text-sm font-bold text-gray-300 hover:text-orange-400 transition-colors duration-300">Servicios</a>
				<a href="#nosotros" class="text-sm font-bold text-gray-300 hover:text-orange-400 transition-colors duration-300">Nosotros</a>
				<a href="#contacto" class="text-sm font-bold text-gray-300 hover:text-orange-400 transition-colors duration-300">Contacto</a>
			</nav>

			<button id="mobile-menu-button" type="button" class="md:hidden text-gray-300 hover:text-orange-400 focus:outline-none" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu">
				<svg id="icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
				</svg>
				<svg id="icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
				</svg>
			</button>
		</div>

		<!-- MENÚ MÓVIL -->
		<nav id="mobile-menu" class="hidden md:hidden bg-[#0a0a0a]/95 backdrop-blur-md border-t border-gray-800">
			<div class="container mx-auto px-6 py-4 flex flex-col">
				<a href="#inicio" class="mobile-link py-4 text-base font-bold text-gray-300 hover:text-orange-400 border-b border-gray-900 transition-colors duration-300">Inicio</a>
				<a href="#servicios" class="mobile-link py-4 text-base font-bold text-gray-300 hover:text-orange-400 border-b border-gray-900 transition-colors duration-300">Servicios</a>
				<a href="#nosotros" class="mobile-link py-4 text-base font-bold text-gray-300 hover:text-orange-400 border-b border-gray-900 transition-colors duration-300">Nosotros</a>
				<a href="#contacto" class="mobile-link py-4 text-base font-bold text-gray-300 hover:text-orange-400 transition-colors duration-300">Contacto</a>
			</div>
		</nav>
	</header>

	<!-- HERO SECTION -->
	<section id="inicio" class="relative min-h-screen flex items-center justify-center overflow-hidden bg-[#0a0a0a]">
		<!-- Destello naranja sutil de fondo para dar profundidad -->
		<div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-full max-w-2xl h-[400px] bg-orange-600/10 blur-[120px] pointer-events-none rounded-full"></div>
		
		<div class="hero-content text-center px-4 max-w-5xl mx-auto mt-16 relative z-10">
			<h1 class="text-5xl md:text-7xl font-black text-white mb-6 reveal tracking-tighter leading-[1.2]">
				Ingeniería de software <br>
				<span class="text-gradient inline-block min-h-[1.2em]" id="rotating_text"></span>
			</h1>
			<p class="text-lg md:text-xl text-gray-300 max-w-2xl mx-auto mb-10 reveal delay-150ms font-medium leading-relaxed">
				Páginas web, tiendas en línea y sistemas a la medida, diseñados y construidos para que tu negocio crezca con una base técnica sólida.
			</p>
			
			<a href="#contacto" data-track="cta_click" data-track-label="hero_cotiza" class="inline-block bg-gradient-to-r from-orange-500 to-rose-600 text-white font-bold py-4 px-10 rounded-lg hover:from-orange-600 hover:to-rose-700 transition-all duration-300 transform hover:scale-105 shadow-lg shadow-orange-500/20 reveal delay-200ms uppercase tracking-widest text-sm">
				Cotiza tu Proyecto
			</a>
		</div>
	</section>

	<!-- MARCAS EXCLUSIVAS (CAMARGOLD + CADYGH) -->
	<section class="py-14 border-y border-gray-900 bg-[#0a0a0a] relative z-10">
		<div class="container mx-auto px-6 text-center reveal">
			<p class="text-[10px] text-gray-500 font-bold uppercase tracking-[0.3em] mb-8">Desarrollando tecnología para marcas exclusivas</p>
			<div class="flex flex-col md:flex-row justify-center items-center gap-6 md:gap-16">
				<a href="https://camargold.com" target="_blank" rel="noopener noreferrer" aria-label="Camargold" data-track="brand_click" data-track-label="camargold" class="brand-link brand-camargold font-light tracking-[0.4em]">C A M A R G O L D</a>
				<a href="https://cadygh.luckydev.com.mx/" target="_blank" rel="noopener noreferrer" aria-label="Cadygh" data-track="brand_click" data-track-label="cadygh" class="brand-link brand-cadygh font-light tracking-[0.4em]">C A D Y G H</a>
			</div>
		</div>
	</section>

	<!-- SERVICIOS -->
	<section id="servicios" class="py-24 bg-[#101010] relative">
		<div class="container mx-auto px-6 relative z-10">
			<div class="text-center mb-16">
				<h2 class="text-4xl md:text-5xl font-black text-white reveal tracking-tighter">Nuestros <span class="text-gradient">Servicios</span></h2>
				<p class="text-gray-400 mt-6 reveal delay-150ms max-w-2xl mx-auto font-medium text-lg">Soluciones tecnológicas de grado empresarial para lanzar, vender y operar mejor en línea.</p>
			</div>
			
			<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
				<div class="bg-[#0a0a0a] p-10 rounded-xl border border-gray-800 transition-all duration-300 reveal hover:border-gray-500 shadow-xl" data-tilt>
					<h3 class="text-2xl font-black text-white mb-4 tracking-tight">Software a Medida</h3>
					<p class="text-gray-400 font-medium leading-relaxed">Desarrollo de sistemas complejos, automatización de tareas y arquitectura backend de alto rendimiento utilizando Java y Spring Boot.</p>
				</div>
				
				<div class="bg-[#0a0a0a] p-10 rounded-xl border border-orange-500/30 transition-all duration-300 reveal delay-150ms hover:border-orange-500/60 shadow-xl shadow-orange-500/5" data-tilt>
					<div class="text-orange-500 mb-3 font-bold text-xs uppercase tracking-widest">Sitios que convierten</div>
					<h3 class="text-2xl font-black text-white mb-4 tracking-tight">Páginas Web Corporativas</h3>
					<p class="text-gray-400 font-medium leading-relaxed">Sitios y landing pages rápidos, optimizados para Google y diseñados para posicionar tu marca y captar clientes de alto valor.</p>
				</div>
				
				<div class="bg-[#0a0a0a] p-10 rounded-xl border border-gray-800 transition-all duration-300 reveal delay-300ms hover:border-gray-500 shadow-xl" data-tilt>
					<h3 class="text-2xl font-black text-white mb-4 tracking-tight">Tiendas en Línea</h3>
					<p class="text-gray-400 font-medium leading-relaxed">E-commerce a la medida para marcas que quieren vender con una experiencia propia, pagos integrados y control total de su operación.</p>
				</div>
			</div>
		</div>
	</section>

	<!-- SECCIÓN NOSOTROS -->
	<section id="nosotros" class="py-24 bg-[#0a0a0a]">
		<div class="container mx-auto px-6">
			<div class="flex flex-col lg:flex-row items-center gap-16">
				<div class="lg:w-1/2 reveal">
					<div class="relative">
						<!-- Detalle naranja sutil en la imagen -->
						<div class="absolute inset-0 border-2 border-orange-500/20 transform translate-x-4 translate-y-4 rounded-xl"></div>
						<img src="/assets/figmaluckyweb.webp" alt="Arquitectura de Software Corporativa LuckyDev" class="relative rounded-xl shadow-2xl grayscale hover:grayscale-0 transition-all duration-700 z-10 w-full object-cover">
					</div>
				</div>
				<div class="lg:w-1/2">
					<h2 class="text-4xl md:text-5xl font-black text-white mb-6 reveal tracking-tighter">Sobre <span class="text-gradient">LuckyDev</span></h2>
					<p class="text-lg text-gray-300 mb-6 reveal delay-150ms font-medium leading-relaxed">No somos una agencia tradicional; somos ingenieros que construyen la tecnología detrás de tu marca. Hemos desarrollado tiendas, sitios y sistemas propios como Cadygh, así que sabemos lo que cuesta mantener un producto digital funcionando.</p>
					<p class="text-lg text-gray-300 reveal delay-200ms font-medium leading-relaxed">Utilizamos infraestructura sólida y bases de datos robustas para entregar soluciones escalables que ahorran tiempo, se ven bien y aguantan el crecimiento de tu negocio.</p>
				</div>
			</div>
		</div>
	</section>

	<!-- CONTACTO -->
	<section id="contacto" class="py-24 bg-[#101010]">
		<div class="container mx-auto px-6 max-w-3xl">
			<div class="text-center mb-16">
				<h2 class="text-4xl md:text-5xl font-black text-white reveal tracking-tighter">Solicitar <span class="text-gradient">Consultoría</span></h2>
				<p class="text-gray-400 mt-4 reveal delay-150ms font-medium">Cuéntanos de tu proyecto. Nuestro equipo técnico evaluará la viabilidad y te responderá pronto.</p>
			</div>
			
			<form id="contact-form" action="https://formsubmit.co/contacto@luckydev.com.mx" method="POST" class="space-y-6">
				<div class="reveal delay-150ms">
					<label for="servicio" class="block text-xs font-bold text-gray-400 uppercase tracking-widest mb-2">Área de Interés</label>
					<select name="servicio" id="servicio" class="block w-full bg-[#0a0a0a] border border-gray-800 rounded-lg py-4 px-4 text-white font-medium focus:outline-none focus:border-orange-500 focus:ring-1 focus:ring-orange-500 transition-colors">
						<option value="Software a la Medida">Desarrollo de Software a la Medida</option>
						<option value="Landing Page">Diseño Web Corporativo / Landing Pages</option>
						<option value="Ecommerce">Desarrollo de Tienda en Línea / E-commerce</option>
						<option value="Otro">Consultoría Técnica / Otro Proyecto</option>
					</select>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 gap-6 reveal delay-200ms">
					<div>
						<label for="name" class="block text-xs font-bold text-gray-400 uppercase tracking-widest mb-2">Nombre Completo / Empresa</label>
						<input type="text" name="name" id="name" required class="block w-full bg-[#0a0a0a] border border-gray-800 rounded-lg py-4 px-4 text-white font-medium focus:outline-none focus:border-orange-500 focus:ring-1 focus:ring-orange-500 transition-colors">
					</div>
					<div>
						<label for="number" class="block text-xs font-bold text-gray-400 uppercase tracking-widest mb-2">Teléfono Directo</label>
						<input type="tel" name="number" id="number" placeholder="+52 ..." required class="block w-full bg-[#0a0a0a] border border-gray-800 rounded-lg py-4 px-4 text-white font-medium focus:outline-none focus:border-orange-500 focus:ring-1 focus:ring-orange-500 transition-colors">
					</div>
				</div>

				<div class="reveal delay-200ms">
					<label for="email" class="block text-xs font-bold text-gray-400 uppercase tracking-widest mb-2">Correo Corporativo</label>
					<input type="email" name="email" id="email" required class="block w-full bg-[#0a0a0a] border border-gray-800 rounded-lg py-4 px-4 text-white font-medium focus:outline-none focus:border-orange-500 focus:ring-1 focus:ring-orange-500 transition-colors">
				</div>

				<div class="reveal delay-250ms">
					<label for="message" class="block text-xs font-bold text-gray-400 uppercase tracking-widest mb-2">Contexto del Proyecto / Requerimientos</label>
					<textarea id="message" name="message" rows="4" required class="block w-full bg-[#0a0a0a] border border-gray-800 rounded-lg py-4 px-4 text-white font-medium focus:outline-none focus:border-orange-500 focus:ring-1 focus:ring-orange-500 transition-colors resize-none" placeholder="Ej: Necesito una tienda en línea para mi marca / Quiero un sistema para automatizar mi operación..."></textarea>
				</div>
				
				<p class="text-xs text-gray-500 font-medium leading-relaxed text-center max-w-xl mx-auto reveal delay-300ms">
					Usaremos tus datos para responder tu solicitud y cotizar tu proyecto. Al enviar este formulario aceptas el tratamiento de tus datos conforme a nuestro <a href="/aviso-de-privacidad" class="text-orange-400 hover:text-orange-300 underline underline-offset-4 transition-colors duration-300">Aviso de Privacidad</a>.
				</p>

				<div class="text-center reveal delay-300ms pt-4">
					<button type="submit" class="w-full md:w-auto bg-gradient-to-r from-orange-500 to-rose-600 text-white font-bold py-4 px-16 rounded-lg hover:from-orange-600 hover:to-rose-700 transition-all duration-300 transform hover:scale-105 shadow-lg shadow-orange-500/20 text-sm uppercase tracking-widest">
						Enviar Solicitud
					</button>
				</div>
			</form>
		</div>
	</section>

	<!-- FOOTER -->
	<footer class="pt-16 pb-10 bg-[#0a0a0a] border-t border-gray-900">
		<div class="container mx-auto px-6">
			<div class="grid grid-cols-1 md:grid-cols-3 gap-12 text-center md:text-left">
				<div>
					<div class="text-2xl font-black tracking-tighter text-white mb-4">Lucky<span class="text-gradient">Dev</span></div>
					<p class="text-sm text-gray-500 font-medium leading-relaxed max-w-xs mx-auto md:mx-0">Páginas web, tiendas en línea y software a la medida para marcas que quieren crecer.</p>
				</div>

				<div>
					<h4 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-4">Navegación</h4>
					<ul class="space-y-2 text-sm font-medium">
						<li><a href="#servicios" class="text-gray-500 hover:text-orange-400 transition-colors duration-300">Servicios</a></li>
						<li><a href="#nosotros" class="text-gray-500 hover:text-orange-400 transition-colors duration-300">Nosotros</a></li>
						<li><a href="#contacto" class="text-gray-500 hover:text-orange-400 transition-colors duration-300">Contacto</a></li>
						<li><a href="/aviso-de-privacidad" class="text-gray-500 hover:text-orange-400 transition-colors duration-300">Aviso de privacidad</a></li>
					</ul>
				</div>

				<div>
					<h4 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-4">Contacto</h4>
					<ul class="space-y-2 text-sm font-medium">
						<li><a href="mailto:contacto@luckydev.com.mx" data-track="email_click" data-track-label="footer" class="text-gray-500 hover:text-orange-400 transition-colors duration-300">contacto@luckydev.com.mx</a></li>
						<li><a href="https://wa.me/+525533476238" target="_blank" rel="noopener noreferrer" data-track="whatsapp_click" data-track-label="footer" class="text-gray-500 hover:text-orange-400 transition-colors duration-300">WhatsApp</a></li>
					</ul>
				</div>
			</div>

			<div class="mt-12 pt-8 border-t border-gray-900 flex flex-col md:flex-row justify-between items-center gap-6">
				<p class="text-xs text-gray-600 font-medium">© {year} LuckyDev. Todos los derechos reservados. <a href="/aviso-de-privacidad" class="underline underline-offset-4 hover:text-orange-400 transition-colors duration-300">Aviso de privacidad</a> <button type="button" data-cookie-settings class="underline underline-offset-4 hover:text-orange-400 transition-colors duration-300 ml-3">Preferencias de cookies</button></p>
				<div class="flex flex-wrap justify-center gap-2">
					<span class="text-[11px] text-gray-500 font-medium border border-gray-800 rounded-full px-3 py-1">Java</span>
					<span class="text-[11px] text-gray-500 font-medium border border-gray-800 rounded-full px-3 py-1">Spring Boot</span>
					<span class="text-[11px] text-gray-500 font-medium border border-gray-800 rounded-full px-3 py-1">MySQL</span>
					<span class="text-[11px] text-gray-500 font-medium border border-gray-800 rounded-full px-3 py-1">Astro</span>
				</div>
			</div>
		</div>
	</footer>

	<!-- WHATSAPP SVG -->
	<a href="https://wa.me/+525533476238" data-track="whatsapp_click" data-track-label="floating_button" class="fixed right-8 bottom-8 w-14 h-14 bg-gradient-to-tr from-green-500 to-green-400 rounded-full flex items-center justify-center shadow-lg shadow-green-500/30 hover:scale-110 hover:shadow-green-500/50 transition-all duration-300 z-[999]" target="_blank" rel="noopener noreferrer" aria-label="Contacto WhatsApp">
		<svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 24 24">
			<path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.666.598 1.236.786 1.41.872.173.086.275.072.376-.043.101-.115.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824zm-3.423-14.416c-6.627 0-12 5.373-12 12s5.373 12 12 12 12-5.373 12-12-5.373-12-12-12zm.029 18.88c-1.161 0-2.305-.292-3.318-.844l-3.677.964.984-3.595c-.607-1.052-.927-2.277-.927-3.541 0-3.808 3.097-6.904 6.903-6.904 3.803 0 6.901 3.097 6.902 6.904 0 3.807-3.096 6.904-6.903 6.904z"/>
		</svg>
	</a>
</Layout>

<script>
	import VanillaTilt from 'vanilla-tilt';

	document.addEventListener('DOMContentLoaded', () => {
		
		const observer = new IntersectionObserver((entries) => {
			entries.forEach(entry => {
				if (entry.isIntersecting) {
					entry.target.classList.add('visible');
				}
			});
		}, { threshold: 0.1 });
		document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

		VanillaTilt.init(document.querySelectorAll("[data-tilt]") as any, {
			max: 5,
			speed: 400,
			glare: true,
			"max-glare": 0.15
		});

		const header = document.querySelector('#header');
		window.addEventListener('scroll', () => {
			if (window.scrollY > 50) {
				header?.classList.add('bg-[#0a0a0a]/95', 'backdrop-blur-md', 'border-gray-800');
				header?.classList.remove('border-transparent');
			} else {
				header?.classList.remove('bg-[#0a0a0a]/95', 'backdrop-blur-md', 'border-gray-800');
				header?.classList.add('border-transparent');
			}
		});

		const rotatingTextElement = document.querySelector("#rotating_text");
		if (rotatingTextElement) {
			const palabras = ["Escalable", "Para Empresas", "Auditable", "A Medida"];
			let pIdx = 0, lIdx = 0;
			const type = () => {
				if (pIdx === palabras.length) pIdx = 0;
				let p = palabras[pIdx];
				rotatingTextElement.textContent = p.slice(0, ++lIdx);
				if (lIdx === p.length) setTimeout(erase, 1500);
				else setTimeout(type, 80);
			}
			const erase = () => {
				let p = palabras[pIdx];
				rotatingTextElement.textContent = p.slice(0, --lIdx);
				if (lIdx === 0) { 
					rotatingTextElement.innerHTML = "&nbsp;"; 
					pIdx++; 
					setTimeout(type, 500); 
				}
				else setTimeout(erase, 30);
			}
			type();
		}

		// ---------- MENÚ MÓVIL ----------
		const menuBtn = document.querySelector('#mobile-menu-button');
		const mobileMenu = document.querySelector('#mobile-menu');
		const iconOpen = document.querySelector('#icon-open');
		const iconClose = document.querySelector('#icon-close');

		const setMenu = (open: boolean) => {
			mobileMenu?.classList.toggle('hidden', !open);
			iconOpen?.classList.toggle('hidden', open);
			iconClose?.classList.toggle('hidden', !open);
			menuBtn?.setAttribute('aria-expanded', String(open));
			menuBtn?.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
			// Fondo sólido en el header mientras el menú está abierto
			header?.classList.toggle('bg-[#0a0a0a]', open);
		};

		menuBtn?.addEventListener('click', () => {
			setMenu(mobileMenu?.classList.contains('hidden') ?? false);
		});

		document.querySelectorAll('.mobile-link').forEach(link => {
			link.addEventListener('click', () => setMenu(false));
		});

		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') setMenu(false);
		});

		// Si se agranda la pantalla (rotar el celular, escritorio), cerrar el menú
		window.addEventListener('resize', () => {
			if (window.innerWidth >= 768) setMenu(false);
		});

		// ---------- TRACKING (Google Analytics 4 vía gtag) ----------
		const track = (event: string, params: Record<string, unknown> = {}) => {
			const w = window as any;
			if (typeof w.gtag === 'function') {
				w.gtag('event', event, { transport_type: 'beacon', ...params });
			}
		};

		// Clicks en CTAs, marcas y WhatsApp (cualquier elemento con data-track)
		document.querySelectorAll('[data-track]').forEach(el => {
			el.addEventListener('click', () => {
				track(el.getAttribute('data-track') as string, {
					label: el.getAttribute('data-track-label') || undefined
				});
			});
		});

		// Envío del formulario = lead
		const form = document.querySelector('#contact-form') as HTMLFormElement | null;
		form?.addEventListener('submit', () => {
			const servicio = (document.querySelector('#servicio') as HTMLSelectElement | null)?.value;
			track('generate_lead', { service: servicio });
		});
	});
</script>

<style>
	/* Las marcas: letra espaciada original + relleno de color de marca al pasar el cursor */
	.brand-link {
		--brand: #ffffff;
		--brand-2: #ffffff;
		--glow: rgba(255, 255, 255, 0.35);

		position: relative;
		display: inline-block;
		padding: 0.75rem 1rem;
		opacity: 0.6;

